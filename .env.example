# Copy to `.env` for Compose (DOCKER-COMPOSE-004). `.env` is gitignored.
# Demo values only — replace before any shared or production use.

POSTGRES_USER=pixeldive
POSTGRES_PASSWORD=pixeldive
POSTGRES_DB=pixeldive
STORAGE_BACKEND=local
STORAGE_ROOT=/data/images
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=pixeldive
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
MAX_IMAGE_BYTES=33554432
AUTO_CREATE_TABLES=false
ENVIRONMENT=development
AUTH_REQUIRED=false
API_KEYS=
HTTP_INSECURE=true
GRPC_INSECURE=true
# Shared PEM pair used by HTTP and gRPC when per-transport files are unset:
# TLS_CERT_FILE=/certs/server.crt
# TLS_KEY_FILE=/certs/server.key
# TLS_CLIENT_CA_FILE=/certs/clients-ca.crt
# HTTP_TLS_CERT_FILE=/certs/server.crt
# HTTP_TLS_KEY_FILE=/certs/server.key
# GRPC_TLS_CERT_FILE=/certs/server.crt
# GRPC_TLS_KEY_FILE=/certs/server.key
# HEALTHCHECK identity when the server requires client certs (mTLS):
# HTTP_TLS_CLIENT_CERT_FILE=/certs/healthcheck.crt
# HTTP_TLS_CLIENT_KEY_FILE=/certs/healthcheck.key
LOG_JSON=true
LIST_DEFAULT_LIMIT=50
MAX_CONCURRENT_SAVES=8
GC_MIN_AGE_SECONDS=5
ORPHAN_MIN_AGE_SECONDS=60
ORPHAN_SWEEP_INTERVAL_SECONDS=60
RATE_LIMIT_PER_MINUTE=120
TENANT_MAX_UPLOAD_BYTES=1073741824
SESSION_MAX_UPLOAD_BYTES=268435456
S3_MULTIPART_BYTES=8388608
