# DATABASE_URL=postgresql+asyncpg://pixeldive:pixeldive@127.0.0.1:5432/pixeldive
# STORAGE_BACKEND=local
# STORAGE_ROOT=/data/images
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_BUCKET=pixeldive
# S3_REGION=us-east-1
# HTTP_PORT=8000
# GRPC_PORT=50051
# MAX_IMAGE_BYTES=33554432
# AUTO_CREATE_TABLES=false
# AUTH_REQUIRED=true
# API_KEYS=dev-token:tenant-a
# GRPC_INSECURE=false
# GRPC_TLS_CERT_FILE=/certs/server.crt
# GRPC_TLS_KEY_FILE=/certs/server.key
# LOG_JSON=true
# LIST_DEFAULT_LIMIT=50
# MAX_CONCURRENT_SAVES=8
# GC_MIN_AGE_SECONDS=5
# ORPHAN_MIN_AGE_SECONDS=60
